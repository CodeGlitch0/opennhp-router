# NHP-Server image. Pinned OpenNHP 0115f5ff729c8791b2ae1d0daf11f34c4c0f31cf.
# Builds nhp-serverd and the authclient plugin. This is not the auth service.
FROM golang:1.26 AS builder

ARG OPENNHP_REF=0115f5ff729c8791b2ae1d0daf11f34c4c0f31cf
ENV GOTOOLCHAIN=auto

RUN git clone https://github.com/OpenNHP/opennhp.git /src/opennhp \
    && git -C /src/opennhp checkout ${OPENNHP_REF}

WORKDIR /src/opennhp
RUN make init serverd

COPY plugins/authclient /src/authclient
WORKDIR /src/authclient
RUN go build -buildmode=plugin -o /out/authclient.so .

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/opennhp/release/nhp-server /opt/nhp-server
COPY --from=builder /out/authclient.so /opt/nhp-server/plugins/authclient/authclient.so
COPY docker/entrypoint.py /entrypoint.py
COPY opennhp_router /opt/opennhp_router/opennhp_router

ENV PYTHONPATH=/opt/opennhp_router
ENV OPENNHP_SERVER_BIN=/opt/nhp-server/nhp-serverd

ENTRYPOINT ["python3", "/entrypoint.py", "server"]
