# Optional NHP-Relay. Pinned OpenNHP 0115f5ff729c8791b2ae1d0daf11f34c4c0f31cf.
# Started only with the compose profile "relay".
FROM golang:1.26 AS builder

ARG OPENNHP_REF=0115f5ff729c8791b2ae1d0daf11f34c4c0f31cf
ENV GOTOOLCHAIN=auto

RUN git clone https://github.com/OpenNHP/opennhp.git /src/opennhp \
    && git -C /src/opennhp checkout ${OPENNHP_REF}

WORKDIR /src/opennhp
RUN make init relayd

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/opennhp/release/nhp-relay /opt/nhp-relay
COPY docker/entrypoint.py /entrypoint.py
COPY opennhp_router /opt/opennhp_router/opennhp_router

ENV PYTHONPATH=/opt/opennhp_router
ENV OPENNHP_RELAY_BIN=/opt/nhp-relay/nhp-relayd

ENTRYPOINT ["python3", "/entrypoint.py", "relay"]
