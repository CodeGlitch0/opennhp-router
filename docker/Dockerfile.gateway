# NHP-AC image. Builds only the access controller from pinned OpenNHP.
# Commit 0115f5ff729c8791b2ae1d0daf11f34c4c0f31cf. Cipher scheme 0.
# Does not copy NHP-Server or the auth service into this image.
FROM golang:1.26 AS builder

ARG OPENNHP_REF=0115f5ff729c8791b2ae1d0daf11f34c4c0f31cf
ENV GOTOOLCHAIN=auto

RUN git clone https://github.com/OpenNHP/opennhp.git /src/opennhp \
    && git -C /src/opennhp checkout ${OPENNHP_REF}

WORKDIR /src/opennhp
RUN make init acd

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        iptables \
        ipset \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/opennhp/release/nhp-ac /opt/nhp-ac
COPY docker/entrypoint.py /entrypoint.py
COPY docker/forwarder.py /opt/forwarder.py
COPY docker/iptables-deny.sh /iptables-deny.sh
COPY opennhp_router /opt/opennhp_router/opennhp_router

RUN chmod 755 /iptables-deny.sh /entrypoint.py /opt/forwarder.py
ENV PYTHONPATH=/opt/opennhp_router
ENV OPENNHP_AC_BIN=/opt/nhp-ac/nhp-acd

ENTRYPOINT ["python3", "/entrypoint.py", "gateway"]
